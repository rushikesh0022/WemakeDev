LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=
PAYMENT_PROVIDER=fake
AWS_REGION=us-east-1
# Filled from the pico-dev CloudFormation outputs after the free-tier-safe test stack is deployed.
PICO_AWS_API_URL=
PICO_DYNAMODB_TABLE=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Replace the public MVP geocoder with a managed or self-hosted reverse endpoint in production.
# GEOCODING_REVERSE_URL=https://nominatim.openstreetmap.org/reverse

# Amazon Pay remains disabled until merchant onboarding and verified IPN handling are configured.
# PAYMENT_PROVIDER=amazon_pay
# AMAZON_PAY_MERCHANT_ID=
# AMAZON_PAY_ACCESS_KEY=
# AMAZON_PAY_SECRET_KEY=
# AMAZON_PAY_OAUTH_CLIENT_ID=
# Optional OpenAI-compatible endpoint:
# OPENAI_BASE_URL=https://api.openai.com/v1/responses

# OpenRouter example:
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=unbiased/pareto
# OPENROUTER_SITE_URL=http://localhost:3000

# For a fully local model instead:
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:1.5b
