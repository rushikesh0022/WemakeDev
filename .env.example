LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=
# GEOCODING_REVERSE_URL=https://nominatim.openstreetmap.org/reverse

# Or use OpenRouter.
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
